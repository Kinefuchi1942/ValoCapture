<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ValoCapture.Core\ValoCapture.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- パッケージ同梱の targets は $(Platform) が x64 等でないとエラーにするため使わず、x64 版 DLL を直接参照する -->
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" ExcludeAssets="build" GeneratePathProperty="true" />
    <Reference Include="ScreenRecorderLib">
      <HintPath>$(PkgScreenRecorderLib)\build\x64\ScreenRecorderLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

<Window x:Class="ValoRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ValoRecorder.App.ViewModels"
        xmlns:controls="clr-namespace:ValoRecorder.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="ValoRecorder" Width="1500" Height="860"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <controls:EventTypeToBrushConverter x:Key="EventBrush" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- 試合一覧 -->
        <DockPanel Background="{StaticResource PanelBrush}">
            <!-- 録画の状態 -->
            <Border DockPanel.Dock="Top" Margin="10,10,10,0" Padding="10,8" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background" Value="#5A1E25" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TargetText}" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,2,0,0"
                               TextWrapping="Wrap" ToolTip="タスクトレイのアイコンを右クリックして変更できます" />
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                <TextBlock Text="試合" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RecordingsRoot}" Foreground="{StaticResource SubTextBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,8" ToolTip="{Binding RecordingsRoot}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="再読み込み" Command="{Binding ReloadCommand}" Margin="0,0,4,0" />
                    <Button Content="フォルダを選ぶ…" Click="OnChooseFolder" />
                </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SessionItemViewModel">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" Foreground="{StaticResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MapName}" FontSize="14" FontWeight="SemiBold" />
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Foreground="{StaticResource SubTextBrush}" FontSize="11" />
                                <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}">
                                    <Run Text="{Binding QueueName, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Score, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- プレイヤー -->
        <Grid Grid.Column="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="Black" CornerRadius="6" ClipToBounds="True" MouseLeftButtonDown="OnVideoClick">
                <Grid>
                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True"
                                  Stretch="Uniform" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
                    <TextBlock x:Name="PlayerMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}" FontSize="14" />
                </Grid>
            </Border>

            <controls:TimelineBar x:Name="Timeline" Grid.Row="1" Height="26" Margin="0,10,0,0"
                                  Markers="{Binding Events}" SeekRequested="OnTimelineSeek" />

            <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
                <Button x:Name="PlayButton" Content="▶" Width="44" Click="OnPlayPause" ToolTip="再生/一時停止 (Space)" />
                <Button Content="⏮" Width="40" Click="OnPreviousEvent" ToolTip="前のイベント (P)" />
                <Button Content="⏭" Width="40" Click="OnNextEvent" ToolTip="次のイベント (N)" />
                <TextBlock x:Name="TimeText" Margin="12,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" />
                <ComboBox x:Name="SpeedBox" Width="70" Margin="4,0" SelectionChanged="OnSpeedChanged" ToolTip="再生速度">
                    <ComboBoxItem Content="0.25x" Tag="0.25" />
                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                    <ComboBoxItem Content="1x" Tag="1" IsSelected="True" />
                    <ComboBoxItem Content="2x" Tag="2" />
                </ComboBox>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding OffsetText}" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="イベントの位置が動画とずれているときに調整します" />
                    <Button Content="−0.5" Command="{Binding AdjustOffsetCommand}" CommandParameter="-500" />
                    <Button Content="−0.1" Command="{Binding AdjustOffsetCommand}" CommandParameter="-100" />
                    <Button Content="+0.1" Command="{Binding AdjustOffsetCommand}" CommandParameter="100" />
                    <Button Content="+0.5" Command="{Binding AdjustOffsetCommand}" CommandParameter="500" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- イベント一覧 -->
        <DockPanel Grid.Column="2" Background="{StaticResource PanelBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                <TextBlock Text="イベント" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel>
                    <CheckBox Content="キル" IsChecked="{Binding ShowKills}" />
                    <CheckBox Content="デス" IsChecked="{Binding ShowDeaths}" />
                    <CheckBox Content="アシスト" IsChecked="{Binding ShowAssists}" />
                    <CheckBox Content="ラウンド" IsChecked="{Binding ShowRoundStarts}" />
                </WrapPanel>
                <TextBlock Text="クリックで 3 秒前から再生" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
            <ListBox x:Name="EventList" ItemsSource="{Binding Events}" PreviewMouseLeftButtonUp="OnEventClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:EventItemViewModel">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                    Background="{Binding Type, Converter={StaticResource EventBrush}}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontFamily="Consolas" Width="48"
                                       Foreground="{StaticResource SubTextBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RoundText}" Foreground="{StaticResource SubTextBrush}" />
                            <TextBlock Text="{Binding Label}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ValoCapture.Core\ValoCapture.Core.csproj" />
    <ProjectReference Include="..\ValoCapture.Recording\ValoCapture.Recording.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 更新パッケージのバージョンと exe のプロパティに出る。配布し直すたびに上げる -->
    <Version>1.4.7</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイの NotifyIcon のためだけに使う -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- tools/make_icon.py で生成 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Velopack の処理を WPF より先に行うため、App.xaml が生成する Main ではなく Program.Main から起動する -->
    <StartupObject>ValoCapture.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF と型名が衝突するので WinForms / System.Drawing は明示的に using する -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

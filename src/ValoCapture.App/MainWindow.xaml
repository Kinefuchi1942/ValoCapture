<Window x:Class="ValoCapture.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ValoCapture.App.ViewModels"
        xmlns:controls="clr-namespace:ValoCapture.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="ValoCapture" Width="1520" Height="800" MinWidth="1100" MinHeight="600" Icon="Assets/app.ico"
        Background="{StaticResource Ground}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <controls:EventTypeToBrushConverter x:Key="EventBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:RoundEventTypeToBrushConverter x:Key="RoundEventBrush" />
        <!-- スタッツの小見出し -->
        <Style x:Key="StatsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DetailHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- スコアボードの数値の列 -->
        <Style x:Key="BoardCell" TargetType="TextBlock" BasedOn="{StaticResource Num}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Soft}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BoardHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <!-- ラウンドの流れの 1 列。枠や背景は中のセルで出す -->
        <Style x:Key="RoundItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="{Binding SideSwitchMargin}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- スコアボードの行（自分の行を強調）。列の幅はヘッダーと揃える -->
        <DataTemplate x:Key="ScoreRowTemplate" DataType="vm:ScoreRowViewModel">
            <Border CornerRadius="6" Padding="8,3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMe}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="15" CornerRadius="1.5" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Death}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlly}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Kill}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding Agent}" FontSize="13" />
                        <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="4" Background="{StaticResource Accent}" VerticalAlignment="Center"
                                Visibility="{Binding IsMe, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="あなた" FontSize="10" FontWeight="Bold" Foreground="#0B1117" />
                        </Border>
                        <TextBlock Text="MVP" FontFamily="{StaticResource NumFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Spike}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="チームの MVP"
                                   Visibility="{Binding IsMvp, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Acs}" Style="{StaticResource BoardCell}" />
                    <TextBlock Grid.Column="2" Text="{Binding Kills}" Style="{StaticResource BoardCell}" />
                    <TextBlock Grid.Column="3" Text="{Binding Deaths}" Style="{StaticResource BoardCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding Assists}" Style="{StaticResource BoardCell}" />
                    <TextBlock Grid.Column="5" Text="{Binding DiffText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BoardCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiffSign}" Value="1">
                                        <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DiffSign}" Value="-1">
                                        <Setter Property="Foreground" Value="{StaticResource Death}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="6" Text="{Binding AdrText}" Style="{StaticResource BoardCell}" />
                    <TextBlock Grid.Column="7" Text="{Binding HeadshotText}" Style="{StaticResource BoardCell}" />
                    <TextBlock Grid.Column="8" Text="{Binding KastText}" Style="{StaticResource BoardCell}" />
                    <TextBlock Grid.Column="9" Text="{Binding FirstKillsText}" Style="{StaticResource BoardCell}" />
                </Grid>
            </Border>
        </DataTemplate>
        <!-- アイコンは Windows 標準のアイコンフォント -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- ブックマーク（☆）。オンの試合は容量制限で自動削除されない -->
        <Style x:Key="BookmarkToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="ブックマーク（容量制限で削除しない）" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2">
                            <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Soft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                <Setter Property="Foreground" Value="#F2C14E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- イベント一覧の行。再生中のイベントは左にバーを出す（クリックで選んだ行の枠とは別） -->
        <Style x:Key="EventItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ItemStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,0,1">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    Padding="10,6" CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="PlayingBar" Width="3" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1.5"
                                    Background="{StaticResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="PlayingBar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLine}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="DangerSoft" Color="#1AFF5D5D" />
        <SolidColorBrush x:Key="DangerLine" Color="#73FF5D5D" />
        <!-- 見出しのごみ箱。ふだんは目立たせず、乗せると赤くする -->
        <Style x:Key="DeleteIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="ToolTip" Value="この試合をごみ箱に移動 (Delete)" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerLine}" />
                                <Setter Property="Foreground" Value="{StaticResource Death}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="録画中・イベント取得中の試合は削除できません" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Death}" />
            <Setter Property="BorderBrush" Value="{StaticResource Death}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 試合の右クリックメニュー -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Hover}" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1" CornerRadius="8"
                                Padding="4" MinWidth="200">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" FontFamily="{StaticResource NumFont}"
                                           FontSize="12" Foreground="{StaticResource Dim}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Icon" Width="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#243245" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource Rule}" Margin="2,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Grid x:Name="Root" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="236" />
            <ColumnDefinition x:Name="LeftGap" Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightGap" Width="16" />
            <ColumnDefinition x:Name="RightColumn" Width="272" />
        </Grid.ColumnDefinitions>

        <!-- 左：録画の状態と試合一覧 -->
        <DockPanel x:Name="LeftPanel">
            <Border DockPanel.Dock="Top" Padding="14,12" CornerRadius="10" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Panel}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#33FF5D5D" Offset="0" />
                                            <GradientStop Color="#0AFF5D5D" Offset="0.7" />
                                            <GradientStop Color="#161D26" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#73FF5D5D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusTime}" Style="{StaticResource Num}"
                                   FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Dim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Death}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap" ToolTip="録画するモードはタスクトレイのアイコンを右クリックして変更できます" />
                </StackPanel>
            </Border>

            <!-- 新しい版をダウンロードし終えたら、更新するまで出しておく -->
            <Border DockPanel.Dock="Top" Margin="0,10,0,0" Padding="14,12" CornerRadius="10" BorderThickness="1"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="新しいバージョン" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateDetail}" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <Button Style="{StaticResource PrimaryButton}" Content="更新して再起動" Padding="10,7" Command="{Binding ApplyUpdateCommand}"
                            ToolTip="ValoCapture を終了して新しいバージョンに更新し、起動し直します" />
                </StackPanel>
            </Border>

            <Button DockPanel.Dock="Top" Margin="0,10,0,0" Command="{Binding OpenSettingsCommand}"
                    ToolTip="録画先・音声デバイス・容量の上限などを変更します">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,8,0" />
                    <TextBlock Text="設定" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <DockPanel DockPanel.Dock="Top" Margin="4,14,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Command="{Binding ReloadCommand}" ToolTip="再読み込み">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" />
                </Button>
                <TextBlock Text="試合" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Sessions.Count}" Style="{StaticResource Num}" Foreground="{StaticResource Dim}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                     ItemContainerStyle="{StaticResource MatchItemStyle}" ToolTip="{Binding RecordingsRoot}"
                     PreviewMouseRightButtonDown="OnListRightButtonDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="エクスプローラーで開く" Command="{Binding OpenInExplorerCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="削除" Command="{Binding RequestDeleteCommand}" InputGestureText="Delete" Foreground="{StaticResource Death}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SessionItemViewModel">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource BookmarkToggle}" IsChecked="{Binding IsBookmarked, Mode=OneWay}"
                                              Command="{Binding ToggleBookmarkCommand}" Margin="6,0,0,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" Style="{StaticResource Num}"
                                           Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MapName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <Grid DockPanel.Dock="Right">
                                    <TextBlock Style="{StaticResource Num}" FontSize="16" FontWeight="SemiBold"
                                               Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="{Binding Timeline.MyKills, Mode=OneWay}" />
                                        <Run Text="/" Foreground="{StaticResource Dim}" FontWeight="Normal" />
                                        <Run Text="{Binding Timeline.MyDeaths, Mode=OneWay}" />
                                        <Run Text="/" Foreground="{StaticResource Dim}" FontWeight="Normal" />
                                        <Run Text="{Binding Timeline.MyAssists, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Bottom">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasScore}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding QueueName, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding DurationText, Mode=OneWay}" FontFamily="{StaticResource NumFont}" />
                                </TextBlock>
                            </DockPanel>
                            <!-- 勝敗と RR の増減 -->
                            <DockPanel Margin="0,2,0,0">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RankedRatingText}" FontFamily="{StaticResource NumFont}" FontSize="12"
                                           FontWeight="SemiBold" ToolTip="この試合での RR の増減">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Soft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RankedRatingSign}" Value="1">
                                                    <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RankedRatingSign}" Value="-1">
                                                    <Setter Property="Foreground" Value="{StaticResource Death}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ResultText}" FontFamily="{StaticResource NumFont}" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result.Outcome}" Value="Win">
                                                    <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.Outcome}" Value="Loss">
                                                    <Setter Property="Foreground" Value="{StaticResource Death}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.Outcome}" Value="Draw">
                                                    <Setter Property="Foreground" Value="{StaticResource Soft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <controls:MatchStrip Height="4" Margin="0,7,0,0" Events="{Binding StripEvents}" Duration="{Binding Duration}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 中央：プレイヤー -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 見出し：マップ・モード・日時とスコア -->
            <DockPanel x:Name="Header" Margin="2,0,2,10" DataContext="{Binding SelectedSession}">
                <!-- スタッツを出しているときは K/D/A の代わりに勝敗とスコア -->
                <StackPanel x:Name="HeaderResult" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <TextBlock Text="{Binding OutcomeText}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Soft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result.Outcome}" Value="Win">
                                        <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Result.Outcome}" Value="Loss">
                                        <Setter Property="Foreground" Value="{StaticResource Death}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Num}" FontSize="32" FontWeight="SemiBold">
                        <Run Text="{Binding Result.MyScore, Mode=OneWay}" Foreground="{StaticResource Kill}" />
                        <Run Text="–" Foreground="{StaticResource Dim}" FontSize="24" />
                        <Run Text="{Binding Result.OpponentScore, Mode=OneWay}" Foreground="{StaticResource Death}" />
                    </TextBlock>
                </StackPanel>
                <Border x:Name="HeaderScore" DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="{Binding Timeline.MyKills}" Style="{StaticResource Num}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource Kill}" HorizontalAlignment="Right" />
                        <TextBlock Text="キル" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="{Binding Timeline.MyDeaths}" Style="{StaticResource Num}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource Death}" HorizontalAlignment="Right" />
                        <TextBlock Text="デス" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="{Binding Timeline.MyAssists}" Style="{StaticResource Num}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource Assist}" HorizontalAlignment="Right" />
                        <TextBlock Text="アシスト" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
                </Border>
                <!-- 動画とスタッツの切り替え -->
                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="9" Padding="3"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="VideoTab" Style="{StaticResource SegmentItem}" GroupName="View" IsChecked="True" Checked="OnViewTabChecked"
                                     FontFamily="{StaticResource UiFont}" FontSize="13" Padding="4,0" ToolTip="動画 (S で切り替え)">
                            <TextBlock Text="動画" Margin="4,0" />
                        </RadioButton>
                        <RadioButton x:Name="StatsTab" Style="{StaticResource SegmentItem}" GroupName="View" Checked="OnViewTabChecked"
                                     FontFamily="{StaticResource UiFont}" FontSize="13" ToolTip="スコアボード・ラウンドの流れ (S で切り替え)">
                            <TextBlock Text="スタッツ" Margin="4,0" />
                        </RadioButton>
                    </StackPanel>
                </Border>
                <!-- 狭いときは右の切り替えとスコアを優先し、こちらを切り詰める -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="{Binding MapName}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Margin="12,0,0,0">
                        <TextBlock Text="{Binding QueueName}" FontSize="12" Foreground="{StaticResource Soft}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Num}" FontSize="12" Foreground="{StaticResource Soft}" />
                    </Border>
                    <ToggleButton Style="{StaticResource BookmarkToggle}" IsChecked="{Binding IsBookmarked, Mode=OneWay}"
                                  Command="{Binding ToggleBookmarkCommand}" FontSize="18" Margin="10,0,0,0" />
                    <Button Style="{StaticResource DeleteIconButton}" Margin="6,0,0,0"
                            Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- 動画 -->
            <Border x:Name="VideoFrame" Grid.Row="1" Background="Black" CornerRadius="10" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                    MouseLeftButtonDown="OnVideoClick" SizeChanged="OnVideoFrameSizeChanged">
                <Grid x:Name="VideoClip">
                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True" Stretch="Uniform"
                                  Volume="{Binding Volume}" IsMuted="{Binding IsMuted}"
                                  MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
                    <TextBlock x:Name="PlayerMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Dim}" FontSize="14" />
                    <!-- 選んだイベント -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Padding="12,6" CornerRadius="8"
                            Background="#C70B1016" DataContext="{Binding SelectedEvent}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding Type, Converter={StaticResource EventBrush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Num}" FontWeight="SemiBold" Margin="8,0,6,0" />
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Opponent}" Foreground="{StaticResource Soft}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- タイムライン -->
            <Border x:Name="TimelinePanel" Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Padding="16,16,16,8">
                <StackPanel>
                    <controls:TimelineBar x:Name="Timeline" Height="30" Markers="{Binding Events}" SeekRequested="OnTimelineSeek"
                                          ClipStart="{Binding ClipStart}" ClipEnd="{Binding ClipEnd}"
                                          DragStarted="OnTimelineDragStarted" DragCompleted="OnTimelineDragCompleted" />
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="00:00" Style="{StaticResource Num}" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Top" />
                        <TextBlock x:Name="DurationLabel" Style="{StaticResource Num}" FontSize="11" Foreground="{StaticResource Dim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <!-- クリップ：始まりと終わりを決めて保存する -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource SmallButton}" Content="始まり" FontSize="12" Click="OnClipStart" ToolTip="今の位置をクリップの始まりにする (I)" />
                            <TextBlock Text="{Binding ClipRangeText}" Style="{StaticResource Num}" FontSize="12" Foreground="{StaticResource Soft}"
                                       MinWidth="150" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                            <Button Style="{StaticResource SmallButton}" Content="終わり" FontSize="12" Click="OnClipEnd" ToolTip="今の位置をクリップの終わりにする (O)" />
                            <Button Style="{StaticResource SmallButton}" Content="クリップを保存" FontSize="12" Margin="10,0,0,0"
                                    Foreground="{StaticResource Accent}" FontWeight="SemiBold" Command="{Binding SaveClipCommand}"
                                    ToolTip="範囲を録画フォルダの clips に保存します。再エンコードしないので、始まりは直前のキーフレームからになります" />
                            <Button Style="{StaticResource SmallButton}" Margin="4,0,0,0" Command="{Binding ClearClipCommand}" ToolTip="範囲を消す">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作 -->
            <DockPanel x:Name="Controls" Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                <Button Click="OnPreviousEvent" ToolTip="前のイベント (P)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" />
                </Button>
                <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Margin="6,0" Click="OnPlayPause" ToolTip="再生 / 一時停止 (Space)">
                    <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" />
                </Button>
                <Button Click="OnNextEvent" ToolTip="次のイベント (N)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" />
                </Button>
                <TextBlock VerticalAlignment="Center" Margin="14,0,10,0" FontSize="18" Style="{StaticResource Num}">
                    <Run x:Name="PositionRun" Text="00:00" />
                    <Run x:Name="TotalRun" Text="/ 00:00" Foreground="{StaticResource Dim}" />
                </TextBlock>
                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="9" Padding="3"
                        VerticalAlignment="Center">
                    <StackPanel x:Name="SpeedGroup" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Speed" Content="0.25x" Tag="0.25" Checked="OnSpeedChecked" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Speed" Content="0.5x" Tag="0.5" Checked="OnSpeedChecked" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Speed" Content="1x" Tag="1" Checked="OnSpeedChecked" IsChecked="True" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Speed" Content="2x" Tag="2" Checked="OnSpeedChecked" />
                    </StackPanel>
                </Border>

                <!-- 右寄せ：時刻補正・全画面・音量 -->
                <Button DockPanel.Dock="Right" Command="{Binding AdjustOffsetCommand}" CommandParameter="100" ToolTip="イベントを 0.1 秒後ろへ">
                    <TextBlock Text="＋" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding OffsetText}" Style="{StaticResource Num}" FontSize="15"
                           MinWidth="60" TextAlignment="Center" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Command="{Binding AdjustOffsetCommand}" CommandParameter="-100" ToolTip="イベントを 0.1 秒前へ">
                    <TextBlock Text="−" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="時刻補正" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="18,0,8,0"
                           ToolTip="イベントの位置が動画とずれているときに調整します" />
                <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Click="OnToggleFullscreen" ToolTip="全画面 (F)" Margin="10,0,0,0">
                    <TextBlock x:Name="FullscreenGlyph" Style="{StaticResource Glyph}" Text="&#xE740;" />
                </Button>
                <Slider DockPanel.Dock="Right" Style="{StaticResource VolumeSlider}" Width="90" Value="{Binding Volume}" VerticalAlignment="Center"
                        ToolTip="音量 (↑↓)" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Command="{Binding ToggleMuteCommand}" ToolTip="ミュート (M)">
                    <TextBlock Text="&#xE767;">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Text" Value="&#xE74F;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </DockPanel>

            <!-- スタッツ（動画・タイムライン・操作の代わりに出す） -->
            <Grid x:Name="StatsPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed">
                <TextBlock Text="{Binding StatsMessage}" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Stats}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <!-- 自分の成績 -->
                        <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,-8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:StatTile">
                                    <Border Style="{StaticResource PanelBorder}" Padding="12,9,12,8" Margin="0,0,8,0">
                                        <StackPanel>
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Dim}" />
                                            </Viewbox>
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Num}" FontSize="24" FontWeight="SemiBold" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding Sub}" FontFamily="{StaticResource NumFont}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Sub}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ラウンドの流れ -->
                        <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Padding="14,12,14,10"
                                Visibility="{Binding IsRoundBased, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Kill}" Margin="0,0,4,0" />
                                        <TextBlock Text="勝ち" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,12,0" />
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Death}" Margin="0,0,4,0" />
                                        <TextBlock Text="負け" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,12,0" />
                                        <TextBlock Text="E 全滅 · B 爆破 · D 解除 · T 時間切れ" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,12,0" />
                                        <TextBlock Text="クリックで詳細" FontSize="11" Foreground="{StaticResource Dim}" />
                                    </StackPanel>
                                    <TextBlock Text="ラウンドの流れ" Style="{StaticResource StatsHeading}" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ラウンド" Height="22" Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Dim}" Padding="0,4,0,0" />
                                        <TextBlock Text="キル / デス" Height="18" Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Dim}" Padding="0,2,0,0" />
                                        <TextBlock Text="ダメージ" Height="26" Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Dim}" Padding="0,8,0,0" />
                                        <TextBlock Text="購入" Height="14" FontSize="11" Foreground="{StaticResource Dim}" />
                                    </StackPanel>
                                    <ListBox x:Name="RoundList" Grid.Column="1" ItemsSource="{Binding Rounds}" SelectedItem="{Binding SelectedRound}"
                                             ItemContainerStyle="{StaticResource RoundItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:RoundItemViewModel">
                                                <StackPanel Margin="1.5,0">
                                                    <!-- 番号と決着。勝ちは緑、負けは赤。選んだラウンドは枠で示す -->
                                                    <Border Height="22" CornerRadius="4" BorderThickness="1.5" Padding="2,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource LossSoft}" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Won}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource WinSoft}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                            <TextBlock FontFamily="{StaticResource NumFont}" FontSize="12" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Death}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Won}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" " FontSize="6" /><Run
                                                                     Text="{Binding Code, Mode=OneWay}" FontSize="10" />
                                                            </TextBlock>
                                                    </Border>
                                                    <!-- 自分のキル（縦の棒）とデス（赤い点） -->
                                                    <StackPanel Height="18" Margin="0,4,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ItemsControl ItemsSource="{Binding KillMarks}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Rectangle Width="4" Height="12" RadiusX="1" RadiusY="1" Fill="{StaticResource Kill}" Margin="1,0" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Ellipse Width="5" Height="5" Fill="{StaticResource Death}" Margin="1,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding Died, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <!-- 与えたダメージ（試合でいちばん多いラウンドを満タンにした棒） -->
                                                    <Grid Height="26" Margin="0,4,0,0">
                                                        <Border Height="{Binding DamageBar}" VerticalAlignment="Bottom" Margin="2,0" CornerRadius="2,2,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#3B5874" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHighDamage}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource Accent}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>
                                                    <Viewbox Height="14" StretchDirection="DownOnly">
                                                        <TextBlock Text="{Binding BuyText}" FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Buy}" Value="Full">
                                                                            <Setter Property="Foreground" Value="{StaticResource Soft}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Buy}" Value="Eco">
                                                                            <Setter Property="Foreground" Value="#6F7C8F" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Viewbox>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- スコアボード -->
                        <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Padding="14,10,14,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="他のプレイヤーは名前を出さずエージェントで表示" FontSize="11" Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="スコアボード" Style="{StaticResource StatsHeading}" />
                                </DockPanel>
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="エージェント" Style="{StaticResource BoardHead}" TextAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="ACS ▾" Style="{StaticResource BoardHead}" Foreground="{StaticResource Text}"
                                               ToolTip="平均戦闘スコア（この順に並べています）" />
                                    <TextBlock Grid.Column="2" Text="K" Style="{StaticResource BoardHead}" />
                                    <TextBlock Grid.Column="3" Text="D" Style="{StaticResource BoardHead}" />
                                    <TextBlock Grid.Column="4" Text="A" Style="{StaticResource BoardHead}" />
                                    <TextBlock Grid.Column="5" Text="+/−" Style="{StaticResource BoardHead}" />
                                    <TextBlock Grid.Column="6" Text="ADR" Style="{StaticResource BoardHead}" ToolTip="1 ラウンドあたりのダメージ" />
                                    <TextBlock Grid.Column="7" Text="HS%" Style="{StaticResource BoardHead}" ToolTip="当たった弾のうち頭の割合" />
                                    <TextBlock Grid.Column="8" Text="KAST" Style="{StaticResource BoardHead}"
                                               ToolTip="キル・アシスト・生存・トレード（倒されて 5 秒以内に味方がやり返した）のいずれかがあったラウンドの割合" />
                                    <TextBlock Grid.Column="9" Text="FK" Style="{StaticResource BoardHead}" ToolTip="ラウンドの最初のキル" />
                                </Grid>
                                <TextBlock Text="{Binding AllyTitle}" FontSize="11" Foreground="{StaticResource Dim}" Margin="8,6,0,2" />
                                <ItemsControl ItemsSource="{Binding Allies}" ItemTemplate="{StaticResource ScoreRowTemplate}" />
                                <TextBlock Text="{Binding OpponentTitle}" FontSize="11" Foreground="{StaticResource Dim}" Margin="8,8,0,2" />
                                <ItemsControl ItemsSource="{Binding Opponents}" ItemTemplate="{StaticResource ScoreRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 右：イベント -->
        <Border x:Name="RightPanel" Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="10,14,6,10">
            <Grid>
            <DockPanel x:Name="EventsPane">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,4,0">
                    <TextBlock Text="イベント" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Margin="0,10,0,0" DataContext="{Binding SelectedSession.Timeline}">
                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding DataContext.ShowKills, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Kill}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="キル" FontSize="12" />
                                <TextBlock Text="{Binding MyKills}" Style="{StaticResource Num}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding DataContext.ShowDeaths, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Death}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="デス" FontSize="12" />
                                <TextBlock Text="{Binding MyDeaths}" Style="{StaticResource Num}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding DataContext.ShowAssists, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Assist}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="アシスト" FontSize="12" />
                                <TextBlock Text="{Binding MyAssists}" Style="{StaticResource Num}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding DataContext.ShowRoundStarts, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Margin="0,0,5,5" ToolTip="ラウンドの開始を表示します"
                                      Visibility="{Binding DataContext.IsRoundBased, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="ラウンド" FontSize="12" />
                            </StackPanel>
                        </ToggleButton>
                    </WrapPanel>
                    <TextBlock Text="クリックで 3 秒前から再生・右クリックでクリップを保存" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,2,0,8"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox x:Name="EventList" ItemsSource="{Binding Events}" PreviewMouseLeftButtonUp="OnEventClick"
                         PreviewMouseRightButtonDown="OnListRightButtonDown" ItemContainerStyle="{StaticResource EventItemStyle}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="前後をクリップに保存（5 秒前〜3 秒後）" Command="{Binding SaveEventClipCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" FontSize="13" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:EventItemViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 過ぎたイベントは薄くする -->
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Fill="{Binding Type, Converter={StaticResource EventBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                                            <Setter Property="Foreground" Value="{StaticResource Soft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 再生中のイベントから次のイベントまでの進み。行の下の余白に重ねて、行の高さを変えない -->
                                <Border Grid.Column="1" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-4" CornerRadius="1"
                                        Background="{StaticResource Rule}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="{StaticResource Accent}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Progress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Opponent}" Foreground="{StaticResource Soft}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Note}" FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreak}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- スタッツで選んだラウンドの詳細 -->
            <DockPanel x:Name="RoundPane" Margin="6,0,4,0" Visibility="Collapsed" DataContext="{Binding Stats.SelectedRound}">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Opacity" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SideText}" FontFamily="{StaticResource NumFont}" FontSize="12"
                               Foreground="{StaticResource Dim}" VerticalAlignment="Bottom" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <Border DockPanel.Dock="Top" Margin="0,10,0,0" Padding="11,8" CornerRadius="8" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource LossSoft}" />
                            <Setter Property="BorderBrush" Value="{StaticResource LossLine}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Won}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WinSoft}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WinLine}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding ResultTitle, Mode=OneWay}" FontWeight="Bold">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Foreground" Value="{StaticResource Death}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Won}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                        <Run Text="  " /><Run Text="{Binding ResultDetail, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Soft}" />
                    </TextBlock>
                </Border>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" IsEnabled="{Binding CanPlay}"
                        Command="{Binding DataContext.PlayRoundCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        ToolTip="動画に切り替えて、このラウンドの戦闘開始の 3 秒前から再生します (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,8,0" />
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" を再生" /></TextBlock>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                    <TextBlock Text="自分" Style="{StaticResource DetailHeading}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </Grid.Resources>
                        <TextBlock Text="キル / デス" />
                        <TextBlock Grid.Column="1" Text="{Binding KillDeathText}" FontFamily="{StaticResource NumFont}" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Text="ダメージ" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Damage}" FontFamily="{StaticResource NumFont}" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Text="購入" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LoadoutText}" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                   Margin="12,0,0,4" />
                        <TextBlock Grid.Row="3" Text="使った / 残り" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MoneyText}" FontFamily="{StaticResource NumFont}" TextAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0" Visibility="{Binding HasDamage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource DetailHeading}">
                        <Run Text="与えたダメージ" />
                        <Run Text="（" FontWeight="Normal" /><Run Text="頭" FontWeight="Normal" Foreground="{StaticResource Spike}" /><Run Text=" · " FontWeight="Normal" /><Run
                             Text="体" FontWeight="Normal" Foreground="{StaticResource Accent}" /><Run Text=" · 脚）" FontWeight="Normal" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding DamageRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DamageRowViewModel">
                                <Grid Margin="0,0,0,7" ToolTip="{Binding ToolTipText}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Agent}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="8" CornerRadius="2" Background="{StaticResource Field}" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding HeadWidth}" />
                                                <ColumnDefinition Width="{Binding BodyWidth}" />
                                                <ColumnDefinition Width="{Binding LegWidth}" />
                                                <ColumnDefinition Width="{Binding RestWidth}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource Spike}" />
                                            <Border Grid.Column="1" Background="{StaticResource Accent}" />
                                            <Border Grid.Column="2" Background="#3B5874" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Damage}" FontFamily="{StaticResource NumFont}" FontSize="12" TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="イベント（クリックで再生）" Style="{StaticResource DetailHeading}" Margin="0,8,0,4" />
                <ListBox x:Name="RoundEventList" ItemsSource="{Binding Events}" PreviewMouseLeftButtonUp="OnRoundEventClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:RoundEventItemViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Fill="{Binding Type, Converter={StaticResource RoundEventBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource Num}" FontSize="12" Foreground="{StaticResource Soft}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource Dim}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- 削除の確認 -->
    <Grid Background="#9E05080C" DataContext="{Binding DeleteCandidate}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,20,22,18" CornerRadius="12"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#24FF5D5D" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" Foreground="{StaticResource Death}" />
                    </Border>
                    <TextBlock Text="この試合を削除しますか？" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource Field}" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding MapName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataContext.DeleteCandidateDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontFamily="{StaticResource NumFont}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="動画とイベントの記録をごみ箱に移動します。ごみ箱から元に戻せます。" Margin="0,12,0,0" FontSize="13"
                           Foreground="{StaticResource Soft}" TextWrapping="Wrap" />
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="#1AF2C14E" BorderBrush="#59F2C14E" BorderThickness="1"
                        Visibility="{Binding IsBookmarked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="★ ブックマークした試合です" FontSize="12" Foreground="#F2C14E" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="キャンセル" MinWidth="96" ToolTip="Esc"
                            Command="{Binding DataContext.CancelDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="削除" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource DangerButton}" ToolTip="Enter"
                            Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- 更新後の起動時に、更新前の版からの変更点を一度だけ出す -->
    <Grid Background="#9E05080C" Visibility="{Binding IsReleaseNotesOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,20,22,18" CornerRadius="12"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="14" Foreground="{StaticResource Accent}" />
                    </Border>
                    <TextBlock FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="{Binding AppVersion, Mode=OneTime}" FontFamily="{StaticResource NumFont}" /><Run Text=" に更新しました" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding ReleaseNotesDetail}" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Soft}" TextWrapping="Wrap" />
                <Border Margin="0,14,0,0" CornerRadius="8" Background="{StaticResource Field}" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                        Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <ItemsControl ItemsSource="{Binding ReleaseNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Version}" FontFamily="{StaticResource NumFont}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" FontFamily="{StaticResource NumFont}" FontSize="12"
                                                       Foreground="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Changes}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2,0,0">
                                                        <TextBlock Text="・" Foreground="{StaticResource Dim}" FontSize="13" />
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Soft}" FontSize="13" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <DockPanel Margin="0,18,0,0">
                    <Button DockPanel.Dock="Right" Content="OK" MinWidth="96" Style="{StaticResource PrimaryButton}" ToolTip="Enter"
                            Command="{Binding CloseReleaseNotesCommand}" />
                    <Button Content="GitHub でリリースを見る" HorizontalAlignment="Left" Foreground="{StaticResource Accent}"
                            BorderBrush="Transparent" Background="Transparent" Style="{StaticResource SmallButton}"
                            Command="{Binding OpenReleasePageCommand}" ToolTip="ブラウザーでリリースの一覧を開きます" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- 削除・クリップの保存の通知（タイムラインと操作にかからないよう、動画の下端に出す） -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,162" Padding="16,6,8,6" CornerRadius="10"
            Background="{StaticResource Hover}" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ToastText}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding ToastText}" FontSize="13" VerticalAlignment="Center" Margin="0,4,8,4" />
            <Button Content="{Binding ToastActionText}" Command="{Binding ToastActionCommand}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                    BorderBrush="Transparent" Background="Transparent" Padding="8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastActionText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
    </Grid>
</Window>

<Window x:Class="ValoCapture.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ValoCapture.App.ViewModels"
        xmlns:controls="clr-namespace:ValoCapture.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="ValoCapture" Width="1520" Height="800" MinWidth="1100" MinHeight="600" Icon="Assets/app.ico"
        Background="{StaticResource Ground}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <controls:EventTypeToBrushConverter x:Key="EventBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- アイコンは Windows 標準のアイコンフォント -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- ブックマーク（☆）。オンの試合は容量制限で自動削除されない -->
        <Style x:Key="BookmarkToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="ブックマーク（容量制限で削除しない）" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2">
                            <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Soft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                <Setter Property="Foreground" Value="#F2C14E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <SolidColorBrush x:Key="DangerSoft" Color="#1AFF5D5D" />
        <SolidColorBrush x:Key="DangerLine" Color="#73FF5D5D" />
        <!-- 見出しのごみ箱。ふだんは目立たせず、乗せると赤くする -->
        <Style x:Key="DeleteIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="ToolTip" Value="この試合をごみ箱に移動 (Delete)" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerLine}" />
                                <Setter Property="Foreground" Value="{StaticResource Death}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="録画中・イベント取得中の試合は削除できません" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Death}" />
            <Setter Property="BorderBrush" Value="{StaticResource Death}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 試合の右クリックメニュー -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Hover}" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1" CornerRadius="8"
                                Padding="4" MinWidth="200">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" FontFamily="{StaticResource NumFont}"
                                           FontSize="12" Foreground="{StaticResource Dim}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Icon" Width="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#243245" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource Rule}" Margin="2,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Grid x:Name="Root" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="236" />
            <ColumnDefinition x:Name="LeftGap" Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightGap" Width="16" />
            <ColumnDefinition x:Name="RightColumn" Width="272" />
        </Grid.ColumnDefinitions>

        <!-- 左：録画の状態と試合一覧 -->
        <DockPanel x:Name="LeftPanel">
            <Border DockPanel.Dock="Top" Padding="14,12" CornerRadius="10" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Panel}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#33FF5D5D" Offset="0" />
                                            <GradientStop Color="#0AFF5D5D" Offset="0.7" />
                                            <GradientStop Color="#161D26" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#73FF5D5D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusTime}" Style="{StaticResource Num}"
                                   FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Dim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Death}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap" ToolTip="録画するモードはタスクトレイのアイコンを右クリックして変更できます" />
                </StackPanel>
            </Border>

            <Button DockPanel.Dock="Top" Margin="0,10,0,0" Command="{Binding OpenSettingsCommand}"
                    ToolTip="録画先・音声デバイス・容量の上限などを変更します">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,8,0" />
                    <TextBlock Text="設定" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <DockPanel DockPanel.Dock="Top" Margin="4,14,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Command="{Binding ReloadCommand}" ToolTip="再読み込み">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" />
                </Button>
                <TextBlock Text="試合" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Sessions.Count}" Style="{StaticResource Num}" Foreground="{StaticResource Dim}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                     ItemContainerStyle="{StaticResource MatchItemStyle}" ToolTip="{Binding RecordingsRoot}"
                     PreviewMouseRightButtonDown="OnMatchRightButtonDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="エクスプローラーで開く" Command="{Binding OpenInExplorerCommand}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="削除" Command="{Binding RequestDeleteCommand}" InputGestureText="Delete" Foreground="{StaticResource Death}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SessionItemViewModel">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource BookmarkToggle}" IsChecked="{Binding IsBookmarked, Mode=OneWay}"
                                              Command="{Binding ToggleBookmarkCommand}" Margin="6,0,0,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" Style="{StaticResource Num}"
                                           Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MapName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <Grid DockPanel.Dock="Right">
                                    <TextBlock Style="{StaticResource Num}" FontSize="16" FontWeight="SemiBold"
                                               Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="{Binding Timeline.MyKills, Mode=OneWay}" />
                                        <Run Text="/" Foreground="{StaticResource Dim}" FontWeight="Normal" />
                                        <Run Text="{Binding Timeline.MyDeaths, Mode=OneWay}" />
                                        <Run Text="/" Foreground="{StaticResource Dim}" FontWeight="Normal" />
                                        <Run Text="{Binding Timeline.MyAssists, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Bottom">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasScore}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ResultText, Mode=OneWay}" FontFamily="{StaticResource NumFont}" FontWeight="SemiBold">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Result.Outcome}" Value="Win">
                                                        <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Result.Outcome}" Value="Loss">
                                                        <Setter Property="Foreground" Value="{StaticResource Death}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Result.Outcome}" Value="Draw">
                                                        <Setter Property="Foreground" Value="{StaticResource Soft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run><Run Text="{Binding QueueName, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding DurationText, Mode=OneWay}" FontFamily="{StaticResource NumFont}" />
                                </TextBlock>
                            </DockPanel>
                            <controls:MatchStrip Height="4" Margin="0,7,0,0" Events="{Binding StripEvents}" Duration="{Binding Duration}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 中央：プレイヤー -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 見出し：マップ・モード・日時とスコア -->
            <DockPanel x:Name="Header" Margin="2,0,2,10" DataContext="{Binding SelectedSession}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="{Binding Timeline.MyKills}" Style="{StaticResource Num}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource Kill}" HorizontalAlignment="Right" />
                        <TextBlock Text="キル" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="{Binding Timeline.MyDeaths}" Style="{StaticResource Num}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource Death}" HorizontalAlignment="Right" />
                        <TextBlock Text="デス" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock Text="{Binding Timeline.MyAssists}" Style="{StaticResource Num}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource Assist}" HorizontalAlignment="Right" />
                        <TextBlock Text="アシスト" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MapName}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Margin="12,0,0,0">
                        <TextBlock Text="{Binding QueueName}" FontSize="12" Foreground="{StaticResource Soft}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Num}" FontSize="12" Foreground="{StaticResource Soft}" />
                    </Border>
                    <ToggleButton Style="{StaticResource BookmarkToggle}" IsChecked="{Binding IsBookmarked, Mode=OneWay}"
                                  Command="{Binding ToggleBookmarkCommand}" FontSize="18" Margin="10,0,0,0" />
                    <Button Style="{StaticResource DeleteIconButton}" Margin="6,0,0,0"
                            Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- 動画 -->
            <Border x:Name="VideoFrame" Grid.Row="1" Background="Black" CornerRadius="10" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                    MouseLeftButtonDown="OnVideoClick" SizeChanged="OnVideoFrameSizeChanged">
                <Grid x:Name="VideoClip">
                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True" Stretch="Uniform"
                                  Volume="{Binding Volume}" IsMuted="{Binding IsMuted}"
                                  MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
                    <TextBlock x:Name="PlayerMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Dim}" FontSize="14" />
                    <!-- 選んだイベント -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Padding="12,6" CornerRadius="8"
                            Background="#C70B1016" DataContext="{Binding SelectedEvent}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding Type, Converter={StaticResource EventBrush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Num}" FontWeight="SemiBold" Margin="8,0,6,0" />
                            <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- タイムライン -->
            <Border x:Name="TimelinePanel" Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Padding="16,16,16,8">
                <StackPanel>
                    <controls:TimelineBar x:Name="Timeline" Height="30" Markers="{Binding Events}" SeekRequested="OnTimelineSeek"
                                          DragStarted="OnTimelineDragStarted" DragCompleted="OnTimelineDragCompleted" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="DurationLabel" DockPanel.Dock="Right" Style="{StaticResource Num}" FontSize="11" Foreground="{StaticResource Dim}" />
                        <TextBlock Text="00:00" Style="{StaticResource Num}" FontSize="11" Foreground="{StaticResource Dim}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 操作 -->
            <DockPanel x:Name="Controls" Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                <Button Click="OnPreviousEvent" ToolTip="前のイベント (P)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" />
                </Button>
                <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Margin="6,0" Click="OnPlayPause" ToolTip="再生 / 一時停止 (Space)">
                    <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" />
                </Button>
                <Button Click="OnNextEvent" ToolTip="次のイベント (N)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" />
                </Button>
                <TextBlock VerticalAlignment="Center" Margin="14,0,10,0" FontSize="18" Style="{StaticResource Num}">
                    <Run x:Name="PositionRun" Text="00:00" />
                    <Run x:Name="TotalRun" Text="/ 00:00" Foreground="{StaticResource Dim}" />
                </TextBlock>
                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="9" Padding="3"
                        VerticalAlignment="Center">
                    <StackPanel x:Name="SpeedGroup" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Speed" Content="0.25x" Tag="0.25" Checked="OnSpeedChecked" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Speed" Content="0.5x" Tag="0.5" Checked="OnSpeedChecked" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Speed" Content="1x" Tag="1" Checked="OnSpeedChecked" IsChecked="True" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="Speed" Content="2x" Tag="2" Checked="OnSpeedChecked" />
                    </StackPanel>
                </Border>

                <!-- 右寄せ：時刻補正・全画面・音量 -->
                <Button DockPanel.Dock="Right" Command="{Binding AdjustOffsetCommand}" CommandParameter="100" ToolTip="イベントを 0.1 秒後ろへ">
                    <TextBlock Text="＋" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding OffsetText}" Style="{StaticResource Num}" FontSize="15"
                           MinWidth="60" TextAlignment="Center" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Command="{Binding AdjustOffsetCommand}" CommandParameter="-100" ToolTip="イベントを 0.1 秒前へ">
                    <TextBlock Text="−" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="時刻補正" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="18,0,8,0"
                           ToolTip="イベントの位置が動画とずれているときに調整します" />
                <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Click="OnToggleFullscreen" ToolTip="全画面 (F)" Margin="10,0,0,0">
                    <TextBlock x:Name="FullscreenGlyph" Style="{StaticResource Glyph}" Text="&#xE740;" />
                </Button>
                <Slider DockPanel.Dock="Right" Style="{StaticResource VolumeSlider}" Width="90" Value="{Binding Volume}" VerticalAlignment="Center"
                        ToolTip="音量 (↑↓)" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Command="{Binding ToggleMuteCommand}" ToolTip="ミュート (M)">
                    <TextBlock Text="&#xE767;">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Text" Value="&#xE74F;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </DockPanel>
        </Grid>

        <!-- 右：イベント -->
        <Border x:Name="RightPanel" Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="10,14,6,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,0,4,0">
                    <TextBlock Text="イベント" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Margin="0,10,0,0" DataContext="{Binding SelectedSession.Timeline}">
                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding DataContext.ShowKills, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Kill}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="キル" FontSize="12" />
                                <TextBlock Text="{Binding MyKills}" Style="{StaticResource Num}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding DataContext.ShowDeaths, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Death}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="デス" FontSize="12" />
                                <TextBlock Text="{Binding MyDeaths}" Style="{StaticResource Num}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding DataContext.ShowAssists, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Assist}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="アシスト" FontSize="12" />
                                <TextBlock Text="{Binding MyAssists}" Style="{StaticResource Num}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding DataContext.ShowRoundStarts, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Margin="0,0,5,5" ToolTip="ラウンドの開始を表示します"
                                      Visibility="{Binding DataContext.IsRoundBased, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="ラウンド" FontSize="12" />
                            </StackPanel>
                        </ToggleButton>
                    </WrapPanel>
                    <TextBlock Text="クリックで 3 秒前から再生" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,2,0,8" />
                </StackPanel>

                <ListBox x:Name="EventList" ItemsSource="{Binding Events}" PreviewMouseLeftButtonUp="OnEventClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:EventItemViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Fill="{Binding Type, Converter={StaticResource EventBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource Num}" Foreground="{StaticResource Soft}" />
                                <TextBlock Grid.Column="2" Text="{Binding Label}" />
                                <TextBlock Grid.Column="3" Text="{Binding Note}" FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreak}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Kill}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>

    <!-- 削除の確認 -->
    <Grid Background="#9E05080C" DataContext="{Binding DeleteCandidate}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,20,22,18" CornerRadius="12"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#24FF5D5D" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" Foreground="{StaticResource Death}" />
                    </Border>
                    <TextBlock Text="この試合を削除しますか？" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource Field}" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding MapName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataContext.DeleteCandidateDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontFamily="{StaticResource NumFont}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="動画とイベントの記録をごみ箱に移動します。ごみ箱から元に戻せます。" Margin="0,12,0,0" FontSize="13"
                           Foreground="{StaticResource Soft}" TextWrapping="Wrap" />
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="#1AF2C14E" BorderBrush="#59F2C14E" BorderThickness="1"
                        Visibility="{Binding IsBookmarked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="★ ブックマークした試合です" FontSize="12" Foreground="#F2C14E" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="キャンセル" MinWidth="96" ToolTip="Esc"
                            Command="{Binding DataContext.CancelDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="削除" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource DangerButton}" ToolTip="Enter"
                            Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- 削除したあとの通知（タイムラインと操作にかからないよう、動画の下端に出す） -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,150" Padding="16,6,8,6" CornerRadius="10"
            Background="{StaticResource Hover}" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ToastText}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding ToastText}" FontSize="13" VerticalAlignment="Center" Margin="0,4,8,4" />
            <Button Content="元に戻す" Style="{StaticResource SmallButton}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                    BorderBrush="Transparent" Background="Transparent" Padding="8,0"
                    Command="{Binding UndoDeleteCommand}" Visibility="{Binding CanUndoDelete, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
    </Grid>
</Window>

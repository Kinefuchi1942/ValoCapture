<?xml version="1.0" encoding="utf-8"?>
<!-- .NET を同梱したフォルダを作る。tools/publish.ps1 がこれを vpk pack で Velopack のインストーラーと更新パッケージにする -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\app\</PublishDir>
  </PropertyGroup>
</Project>
